const DB={get(k){try{return JSON.parse(localStorage.getItem('np_'+k))}catch{return null}},set(k,v){localStorage.setItem('np_'+k,JSON.stringify(v))},del(k){localStorage.removeItem('np_'+k)}};
function initDB(){
  if(!DB.get('users')){DB.set('users',[{id:'admin001',username:'nexPLAY.admin',email:'admin@nexplay.gg',password:'julio2012*',role:'admin',avatar:'🛡️',bio:'Administrador oficial de NexPlay',joined:new Date().toISOString(),banned:false,favorites:[],history:[],likesGiven:0,sessions:0,verified:true}])}
  if(!DB.get('games')){DB.set('games',[
    {id:'g1',title:'Súper Salto',dev:'PixelStudios',devId:'admin001',cover:'',desc:'¡Salta lo más alto posible y supera obstáculos en plataformas infinitas!',category:'Plataformas',tags:['salto','pixel','casual'],likes:142,dislikes:8,fire:55,wow:23,love:40,haha:18,sad:5,featured:true,status:'approved',plays:5420,reactions:{}},
    {id:'g2',title:'Carrera Extrema',dev:'SpeedDev',devId:'admin001',cover:'',desc:'Carreras de alta velocidad en pistas imposibles.',category:'Carreras',tags:['carreras','velocidad'],likes:98,dislikes:5,fire:70,wow:40,love:30,haha:12,sad:3,featured:false,status:'approved',plays:3200,reactions:{}},
    {id:'g3',title:'Puzzle Master',dev:'BrainGames',devId:'admin001',cover:'',desc:'Resuelve rompecabezas que desafían tu mente.',category:'Puzzle',tags:['puzzle','lógica'],likes:76,dislikes:3,fire:20,wow:55,love:61,haha:8,sad:2,featured:true,status:'approved',plays:2800,reactions:{}},
    {id:'g4',title:'Arena Fighter',dev:'FightCo',devId:'admin001',cover:'',desc:'Combates épicos en arenas multijugador.',category:'Acción',tags:['pelea','multijugador'],likes:210,dislikes:12,fire:130,wow:88,love:95,haha:22,sad:7,featured:false,status:'approved',plays:8900,reactions:{}},
    {id:'g5',title:'Space Shooter',dev:'GalaxyDev',devId:'admin001',cover:'',desc:'Defiende la galaxia de oleadas de enemigos.',category:'Acción',tags:['espacio','disparos'],likes:154,dislikes:7,fire:88,wow:42,love:77,haha:15,sad:4,featured:true,status:'approved',plays:6100,reactions:{}},
    {id:'g6',title:'Tower Defense Pro',dev:'StrategyHub',devId:'admin001',cover:'',desc:'Construye torres y defiende tu base.',category:'Estrategia',tags:['defensa','estrategia'],likes:89,dislikes:4,fire:45,wow:31,love:50,haha:11,sad:2,featured:false,status:'approved',plays:4100,reactions:{}}
  ])}
  if(!DB.get('teams'))DB.set('teams',[]);
  if(!DB.get('pending'))DB.set('pending',[]);
  if(!DB.get('reports'))DB.set('reports',[]);
  if(!DB.get('notifs'))DB.set('notifs',[{id:'n1',icon:'🎉',title:'¡Bienvenido a NexPlay!',body:'Gracias por unirte. Explora miles de juegos gratis.',time:new Date().toISOString(),read:false,global:true},{id:'n2',icon:'🆕',title:'Nueva versión disponible',body:'NexPlay v2 ya está disponible con nuevas funciones.',time:new Date(Date.now()-3600000).toISOString(),read:false,global:true}]);
  if(!DB.get('logs'))DB.set('logs',[]);
  if(!DB.get('content_blocks'))DB.set('content_blocks',[]);
}
let currentUser=null,currentGame=null,reportTarget=null,cheatFeatures={walls:false,immune:false,speed:false},perfMode=false;
const BAD=['puta','mierda','coño','culo','polla','marica','pendejo','cabron','joder','idiota','estupido','gilipollas','mamada','verga','chinga','carajo','hdp','ojete','perra','zorra','bastardo','imbecil','subnormal','retrasado'];
const RESERVED=['nexplay','moderator','mod','staff','support','root','system'];
function badWord(s){const x=s.toLowerCase().replace(/[@$!30]/g,c=>({'@':'a','$':'s','!':'i','3':'e','0':'o'}[c]||c));return BAD.some(w=>x.includes(w))}
function reserved(s){return RESERVED.some(r=>s.toLowerCase().includes(r))}
// USERNAME CHECK
let unT=null;
function checkUN(v){clearTimeout(unT);const fb=document.getElementById('un-fb');if(!v){fb.textContent='';fb.className='aih';return}unT=setTimeout(async()=>{fb.textContent='🤖 Analizando...';fb.className='aih';await delay(500);const users=DB.get('users')||[];const ex=users.some(u=>u.username.toLowerCase()===v.toLowerCase());if(v.length<3){fb.textContent='⚠️ Mínimo 3 caracteres.';fb.className='aih warn'}else if(v.length>20){fb.textContent='⚠️ Máximo 20 caracteres.';fb.className='aih warn'}else if(badWord(v)){fb.textContent='🚫 IA detectó lenguaje inapropiado.';fb.className='aih bad'}else if(reserved(v)){fb.textContent='🚫 Nombre reservado por el sistema.';fb.className='aih bad'}else if(ex){fb.textContent='❌ Ya existe. Prueba: '+v+Math.floor(Math.random()*99+1);fb.className='aih bad'}else if(!/^[a-zA-Z0-9_.]+$/.test(v)){fb.textContent='⚠️ Solo letras, números, puntos y guiones bajos.';fb.className='aih warn'}else{fb.textContent='✅ ¡Disponible y aprobado por IA!';fb.className='aih ok'}},600)}
// FILE UPLOAD
function previewImg(input,previewId,dataId){const f=input.files[0];if(!f)return;if(f.size>5*1024*1024){toast('Imagen demasiado grande (máx 5MB)','er');return}const r=new FileReader();r.onload=e=>{const img=document.getElementById(previewId);img.src=e.target.result;img.classList.add('show');document.getElementById(dataId).value=e.target.result;// find parent area and update text
const area=img.closest('.file-upload-area');if(area){const t=area.querySelector('.up-text');if(t)t.textContent='✅ Imagen cargada';const s=area.querySelector('.up-sub');if(s)s.style.display='none'}};r.readAsDataURL(f)}
function dragOver(e,areaId){e.preventDefault();document.getElementById(areaId).classList.add('drag')}
function dragLeave(areaId){document.getElementById(areaId).classList.remove('drag')}
function dropFile(e,previewId,dataId){e.preventDefault();const area=e.currentTarget;area.classList.remove('drag');const f=e.dataTransfer.files[0];if(f&&f.type.startsWith('image/')){const r=new FileReader();r.onload=ev=>{const img=document.getElementById(previewId);img.src=ev.target.result;img.classList.add('show');document.getElementById(dataId).value=ev.target.result};r.readAsDataURL(f)}}
// IMAGE PROTECTION
document.addEventListener('contextmenu',e=>{if(e.target.tagName==='IMG'){e.preventDefault();toast('🔒 Imagen protegida por NexPlay','warn')}});
document.addEventListener('dragstart',e=>{if(e.target.tagName==='IMG')e.preventDefault()});
// AUTH
function hideAll(){['splash','login-screen','register-screen','welcome-screen','main-app'].forEach(id=>{const e=document.getElementById(id);if(e){e.classList.add('hidden');e.style.display=''}})}
function showLogin(){hideAll();show('login-screen')}
function showRegister(){hideAll();show('register-screen')}
function show(id){const e=document.getElementById(id);e.classList.remove('hidden');e.style.display='flex'}
function doLogin(){const u=document.getElementById('login-user').value.trim(),p=document.getElementById('login-pass').value,err=document.getElementById('login-error');if(!u||!p){showErr(err,'Completa todos los campos.');return}const users=DB.get('users')||[];const user=users.find(x=>(x.username.toLowerCase()===u.toLowerCase()||x.email.toLowerCase()===u.toLowerCase())&&x.password===p);if(!user){showErr(err,'❌ Usuario o contraseña incorrectos.');return}if(user.banned){showErr(err,'🚫 Cuenta suspendida. Contacta soporte.');return}err.classList.add('hidden');currentUser=user;DB.set('session',user.id);showWelcome(user,false)}
function doRegister(){const un=document.getElementById('reg-un').value.trim(),em=document.getElementById('reg-em').value.trim(),pw=document.getElementById('reg-pw').value,role=document.getElementById('reg-role').value,err=document.getElementById('reg-error');if(!un||!em||!pw){showErr(err,'Completa todos los campos.');return}if(badWord(un)){showErr(err,'🚫 Nombre inapropiado.');return}if(reserved(un)){showErr(err,'🚫 Nombre reservado.');return}const users=DB.get('users')||[];if(users.some(u=>u.username.toLowerCase()===un.toLowerCase())){showErr(err,'❌ Ese usuario ya existe.');return}if(users.some(u=>u.email.toLowerCase()===em.toLowerCase())){showErr(err,'❌ Ese email ya está registrado.');return}if(pw.length<6){showErr(err,'⚠️ Mínimo 6 caracteres.');return}const nu={id:'u_'+Date.now(),username:un,email:em,password:pw,role,avatar:randEmoji(),bio:'',joined:new Date().toISOString(),banned:false,favorites:[],history:[],likesGiven:0,sessions:0,verified:false};users.push(nu);DB.set('users',users);currentUser=nu;DB.set('session',nu.id);err.classList.add('hidden');showWelcome(nu,true)}
function showWelcome(user,isNew){hideAll();document.getElementById('welcome-screen').classList.remove('hidden');document.getElementById('welcome-screen').style.display='flex';document.getElementById('wname').textContent=user.username;document.getElementById('ws1').classList.remove('hidden');document.getElementById('ws2').classList.add('hidden');if(!isNew){document.querySelector('#ws1 h1').innerHTML='¡Hola de nuevo, <span class="gtx">'+user.username+'</span>!';document.getElementById('wmsg').textContent='Bienvenido de vuelta. Tus juegos favoritos te esperan.'}}
function wnext(){document.getElementById('ws1').classList.add('hidden');document.getElementById('ws2').classList.remove('hidden')}
function acceptTerms(){if(!document.getElementById('tcheck').checked){toast('Debes aceptar los términos.','er');return}hideAll();enterApp()}
function enterApp(){document.getElementById('main-app').classList.remove('hidden');document.getElementById('main-app').style.display='flex';setupNav();renderHome();renderCats();showSection('home');const users=DB.get('users')||[];const ui=users.findIndex(u=>u.id===currentUser.id);if(ui!==-1){users[ui].sessions=(users[ui].sessions||0)+1;DB.set('users',users);currentUser=users[ui]}updateNBadge();setTimeout(()=>pushNotif('🎮','¡Listo para jugar!','Explora los juegos más populares.'),1200)}
function setupNav(){if(!currentUser)return;document.getElementById('nav-av').textContent=currentUser.avatar||currentUser.username[0].toUpperCase();document.getElementById('nav-uname').textContent=currentUser.username;document.getElementById('nav-vbadge').innerHTML=currentUser.verified?'<span class="vbadge" title="Verificado"></span>':'';document.getElementById('udrop-av').textContent=currentUser.avatar||currentUser.username[0];document.getElementById('udrop-name').innerHTML=currentUser.username+(currentUser.verified?'<span class="vbadge"></span>':'');document.getElementById('udrop-role').textContent=currentUser.role==='admin'?'🛡️ Administrador':currentUser.role==='dev'?'🎮 Desarrollador':'🕹️ Jugador';if(currentUser.role==='admin'){document.getElementById('admin-link').style.display='';document.getElementById('dev-link').style.display='';document.getElementById('dev-btn').style.display=''}if(currentUser.role==='dev'){document.getElementById('dev-link').style.display='';document.getElementById('dev-btn').style.display=''}}
function doLogout(){DB.del('session');currentUser=null;document.getElementById('udrop').classList.add('hidden');hideAll();document.getElementById('splash').classList.remove('hidden');toast('Sesión cerrada. ¡Hasta pronto! 👋','info')}
// NAVIGATION
function showSection(id){document.querySelectorAll('.sec').forEach(s=>s.classList.remove('active'));const s=document.getElementById('sec-'+id);if(s)s.classList.add('active');document.getElementById('udrop').classList.add('hidden');document.getElementById('notif-panel').classList.add('hidden');if(id==='profile')renderProfile();if(id==='admin')renderAdmin();if(id==='dev')renderDev();if(id==='favorites')renderFavs();if(id==='history')renderHist();if(id==='achievements')renderAch()}
function goHome(){showSection('home')}
document.addEventListener('click',e=>{if(!e.target.closest('.nav-user'))document.getElementById('udrop').classList.add('hidden');if(!e.target.closest('.nav-search'))document.getElementById('sdrop').classList.add('hidden');if(!e.target.closest('#notif-btn')&&!e.target.closest('.notif-panel'))document.getElementById('notif-panel').classList.add('hidden')});
function toggleUD(){document.getElementById('udrop').classList.toggle('hidden')}
// PERFORMANCE MODE
function togglePerfMode(on){perfMode=on;document.body.classList.toggle('perf-mode',on);if(on){toast('⚡ Modo rendimiento activado — menos animaciones, más FPS','ok')}else{toast('Modo rendimiento desactivado','info')}}
function toggleAnimations(on){document.querySelectorAll('*').forEach(el=>{el.style.animationPlayState=on?'paused':'running'})}
function toggleCompact(on){document.querySelectorAll('.gg').forEach(g=>g.style.gridTemplateColumns=`repeat(auto-fill,minmax(${on?'130px':'165px'},1fr))`)}
// AD BLOCKER
function blockAds(){const sel=['iframe[src*="ads"]','iframe[src*="doubleclick"]','div[class*="ad-"]','div[id*="ad-"]','ins.adsbygoogle'];sel.forEach(s=>{try{document.querySelectorAll(s).forEach(el=>el.remove())}catch(e){}});const obs=new MutationObserver(()=>blockAds());obs.observe(document.body,{childList:true,subtree:true})}
// GAMES
const CATS=[{n:'Acción',i:'⚔️'},{n:'Puzzle',i:'🧩'},{n:'Carreras',i:'🏎️'},{n:'Plataformas',i:'🏃'},{n:'Aventura',i:'🗺️'},{n:'Deportes',i:'⚽'},{n:'Estrategia',i:'♟️'},{n:'Casual',i:'🎈'},{n:'Multijugador',i:'👥'},{n:'RPG',i:'🧙'},{n:'Terror',i:'👻'},{n:'Tirador',i:'🎯'}];
function gcImg(g){return g.cover||`data:image/svg+xml;base64,${btoa('<svg xmlns="http://www.w3.org/2000/svg" width="160" height="160"><rect width="160" height="160" fill="#1a1a32"/><text y="90" x="80" text-anchor="middle" font-size="64">🎮</text></svg>')}`}
function renderHome(){const games=(DB.get('games')||[]).filter(g=>g.status==='approved');renderGG('featured-games',games.filter(g=>g.featured).slice(0,8));renderGG('new-games',[...games].reverse().slice(0,8));renderGG('popular-games',[...games].sort((a,b)=>(b.plays||0)-(a.plays||0)).slice(0,8));renderCustomBlocks()}
function renderCustomBlocks(){const blocks=DB.get('content_blocks')||[];const el=document.getElementById('home-custom-blocks');if(!el)return;el.innerHTML=blocks.map(b=>`<div class="content-block" style="background:${b.color||'var(--card)'}"><div class="content-block-header"><h4>${b.title||''}</h4></div>${b.img?`<img src="${b.img}" style="width:100%;max-height:220px;object-fit:cover;border-radius:12px;margin-bottom:14px;pointer-events:none;-webkit-user-drag:none" alt=""/>`:''}${b.body?`<p style="color:var(--tx2);font-size:14px;line-height:1.7">${b.body}</p>`:''}</div>`).join('')}
function renderFilteredHome(type){const games=(DB.get('games')||[]).filter(g=>g.status==='approved');let list=games;if(type==='featured')list=games.filter(g=>g.featured);else if(type==='new')list=[...games].reverse();else if(type==='popular')list=[...games].sort((a,b)=>(b.plays||0)-(a.plays||0));renderGG('featured-games',list);renderGG('new-games',[]);renderGG('popular-games',[])}
function renderCats(){document.getElementById('catg').innerHTML=CATS.map(c=>`<div class="catc" onclick="filterCat('${c.n}')"><span class="ci">${c.i}</span><span class="cn">${c.n}</span></div>`).join('')}
function filterCat(cat){const games=(DB.get('games')||[]).filter(g=>g.status==='approved'&&g.category===cat);document.getElementById('cat-title').textContent=(CATS.find(c=>c.n===cat)?.i||'')+' '+cat;renderGG('cat-gg',games);document.getElementById('cat-results').classList.remove('hidden');document.getElementById('cat-results').scrollIntoView({behavior:'smooth'})}
function renderGG(id,games){const el=document.getElementById(id);if(!el)return;if(!games||!games.length){el.innerHTML='<p style="color:var(--tx2);padding:20px;grid-column:1/-1;text-align:center">Sin juegos aquí todavía.</p>';return}el.innerHTML=games.map(g=>gameCard(g)).join('')}
function gameCard(g){const badge=g.featured?'<div class="gc-badge feat">⭐ Top</div>':'';const sb=g.status==='pending'?'<div class="gc-badge pend">⏳</div>':g.status==='banned'?'<div class="gc-badge ban">🚫</div>':badge;return`<div class="gc" onclick="openGame('${g.id}')">${sb}<img src="${gcImg(g)}" alt="${g.title}" loading="lazy" style="-webkit-user-drag:none;pointer-events:none"/><div class="gc-info"><div class="gc-title">${g.title}</div><div class="gc-meta"><span>👍${g.likes||0}</span><span>🎮${fmtN(g.plays||0)}</span></div></div></div>`}
function openGame(id){const games=DB.get('games')||[];const g=games.find(x=>x.id===id);if(!g)return;if(g.status==='banned'){toast('Este juego ha sido suspendido.','er');return}if(g.status==='pending'){toast('Pendiente de revisión.','wa');return}currentGame=g;const idx=games.findIndex(x=>x.id===id);games[idx].plays=(games[idx].plays||0)+1;DB.set('games',games);if(currentUser){const users=DB.get('users')||[];const ui=users.findIndex(u=>u.id===currentUser.id);if(ui!==-1){users[ui].history=[id,...(users[ui].history||[]).filter(h=>h!==id)].slice(0,30);DB.set('users',users);currentUser=users[ui]}}showSection('game');document.getElementById('game-iframe').src=g.url||'about:blank';document.getElementById('gm-cov').src=gcImg(g);document.getElementById('gm-title').textContent=g.title;document.getElementById('gm-dev').textContent='por '+g.dev;document.getElementById('gm-desc').textContent=g.desc;document.getElementById('gm-tags').innerHTML=(g.tags||[]).map(t=>`<span class="gtag">${t}</span>`).join('');const fb=document.getElementById('fav-btn');fb.classList.toggle('on',currentUser?(currentUser.favorites||[]).includes(id):false);document.getElementById('cheat-btn').style.display=currentUser?.role==='admin'?'':'none';renderReactions(g);const others=(DB.get('games')||[]).filter(x=>x.status==='approved'&&x.id!==id).slice(0,10);document.getElementById('sgames').innerHTML=others.map(x=>`<div class="sgame" onclick="openGame('${x.id}')"><img src="${gcImg(x)}" alt="${x.title}" style="pointer-events:none"/><div><div class="sgame-t">${x.title}</div><div class="sgame-s">👍${x.likes||0} · 🎮${fmtN(x.plays||0)}</div></div></div>`).join('')}
// REACTIONS — 1 per user per type
const RTYPES=[{k:'likes',i:'👍',l:'Me gusta',d:false},{k:'dislikes',i:'👎',l:'No me gusta',d:true},{k:'fire',i:'🔥',l:'En llamas',d:false},{k:'wow',i:'😮',l:'Increíble',d:false},{k:'love',i:'❤️',l:'Me encanta',d:false},{k:'haha',i:'😂',l:'Divertido',d:false},{k:'sad',i:'😢',l:'Triste',d:false}];
function renderReactions(g){if(!currentUser)return;const ur=getUserR(g.id);document.getElementById('reactions-bar').innerHTML=RTYPES.map(r=>`<button class="rb ${ur[r.k]?'on':''}${r.d&&ur[r.k]?' dis':''}" onclick="doReact('${r.k}')"><span class="rb-tt">${r.l}</span><span class="ri">${r.i}</span><span class="rc" id="rc-${r.k}">${g[r.k]||0}</span></button>`).join('')}
function getUserR(gid){return DB.get('reacts_'+currentUser.id+'_'+gid)||{}}
function doReact(type){if(!currentUser){toast('Inicia sesión para reaccionar.','er');return}if(!currentGame)return;const games=DB.get('games')||[];const idx=games.findIndex(g=>g.id===currentGame.id);if(idx===-1)return;const rkey='reacts_'+currentUser.id+'_'+currentGame.id;const ur=DB.get(rkey)||{};const wasOn=ur[type];if(wasOn){ur[type]=false;games[idx][type]=Math.max(0,(games[idx][type]||0)-1);toast('Reacción eliminada','info')}else{if(type==='likes'&&ur['dislikes']){ur['dislikes']=false;games[idx]['dislikes']=Math.max(0,(games[idx]['dislikes']||0)-1)}if(type==='dislikes'&&ur['likes']){ur['likes']=false;games[idx]['likes']=Math.max(0,(games[idx]['likes']||0)-1)}ur[type]=true;games[idx][type]=(games[idx][type]||0)+1;if(type==='likes'){const users=DB.get('users')||[];const ui=users.findIndex(u=>u.id===currentUser.id);if(ui!==-1){users[ui].likesGiven=(users[ui].likesGiven||0)+1;DB.set('users',users);currentUser=users[ui]}}const labels={likes:'👍 ¡Te gustó!',dislikes:'👎 No te gustó.',fire:'🔥 ¡En llamas!',wow:'😮 ¡Increíble!',love:'❤️ ¡Te encantó!',haha:'😂 ¡Divertido!',sad:'😢 ¡Triste!'};toast(labels[type]||'Reaccionaste','ok')}DB.set(rkey,ur);DB.set('games',games);currentGame=games[idx];renderReactions(games[idx])}
function toggleFav(){if(!currentUser){toast('Inicia sesión.','er');return}const users=DB.get('users')||[];const ui=users.findIndex(u=>u.id===currentUser.id);if(ui===-1)return;const favs=users[ui].favorites||[];const isFav=favs.includes(currentGame.id);users[ui].favorites=isFav?favs.filter(f=>f!==currentGame.id):[...favs,currentGame.id];DB.set('users',users);currentUser=users[ui];document.getElementById('fav-btn').classList.toggle('on',!isFav);toast(isFav?'💔 Eliminado':'❤️ Añadido a favoritos',isFav?'info':'ok')}
function shareGame(){const content=`<div class="share-card"><div class="sc-img">${currentGame?.cover?`<img src="${currentGame.cover}" style="width:80px;height:80px;border-radius:50%;object-fit:cover" alt=""/>`:currentUser?.avatar||'🎮'}</div><div class="sc-name">${currentGame?.title||''}</div><div class="sc-role">NexPlay — Juego gratuito</div></div>`;document.getElementById('share-content').innerHTML=content;window._shareText='🎮 '+currentGame?.title+' en NexPlay';showModal('share-modal')}
function copyShareContent(){if(navigator.clipboard)navigator.clipboard.writeText(window._shareText||'NexPlay');toast('📋 Copiado','ok')}
function showReportModal(){document.getElementById('report-options').innerHTML=['Contenido inapropiado','Juego roto / no funciona','Derechos de autor','Spam / Publicidad','Trampa / Hack','Otro'].map(r=>`<div class="report-option" onclick="selectReport('${r}')">${r}</div>`).join('');showModal('report-modal')}
let selectedReport='';function selectReport(r){selectedReport=r;document.querySelectorAll('.report-option').forEach(el=>{el.style.borderColor=el.textContent.trim()===r?'var(--er)':'var(--bd)';el.style.color=el.textContent.trim()===r?'var(--er)':'var(--tx)'})}
function submitReport(){if(!selectedReport){toast('Selecciona un motivo.','er');return}const reports=DB.get('reports')||[];reports.unshift({id:'r_'+Date.now(),type:'game',target:currentGame?.id,targetName:currentGame?.title,reason:selectedReport,detail:document.getElementById('report-detail').value,by:currentUser?.username||'anon',time:new Date().toISOString(),status:'pending'});DB.set('reports',reports);closeModal('report-modal');toast('🚩 Reporte enviado. Lo revisaremos.','ok');addNotif('🚩','Nuevo reporte de juego','Juego "'+currentGame?.title+'" reportado por: '+selectedReport,false,'admin001')}
let reportUserTarget=null;function showReportUser(userId,username){reportUserTarget={id:userId,username};document.getElementById('report-user-name').textContent=username;showModal('report-user-modal')}
function sendUserReport(reason){if(!reportUserTarget)return;const reports=DB.get('reports')||[];reports.unshift({id:'r_'+Date.now(),type:'user',target:reportUserTarget.id,targetName:reportUserTarget.username,reason,by:currentUser?.username||'anon',time:new Date().toISOString(),status:'pending'});DB.set('reports',reports);closeModal('report-user-modal');toast('🚩 Usuario reportado. Gracias.','ok');addNotif('🚩','Nuevo reporte de usuario',reportUserTarget.username+' reportado por: '+reason,false,'admin001')}
function addToList(){toast('📋 Añadido a tu lista','ok')}
function viewTeamFromGame(){if(!currentGame)return;const teams=DB.get('teams')||[];const t=teams.find(x=>x.ownerId===currentGame.devId);if(!t){toast('Este equipo no tiene perfil público.','info');return}viewTeamProfile(t.id)}
// GAME PERFORMANCE
function toggleGamePerf(){const btn=document.getElementById('perf-game-btn');const iframe=document.getElementById('game-iframe');perfMode=!perfMode;btn.classList.toggle('on',perfMode);btn.textContent=perfMode?'⚡ Modo Rápido: ON':'⚡ Modo Rápido';if(perfMode){iframe.style.imageRendering='pixelated';document.getElementById('gframe-wrap').style.filter='contrast(0.95) saturate(0.9)';toast('⚡ Modo rendimiento activo — menos efectos, más FPS','ok')}else{iframe.style.imageRendering='';document.getElementById('gframe-wrap').style.filter='';toast('Modo normal activado','info')}}
// ADMIN CHEAT MOD
function toggleCheat(){document.getElementById('cheat-hud').classList.toggle('hidden')}
function hideCheat(){document.getElementById('cheat-hud').classList.add('hidden')}
function toggleCheatFeature(f){if(currentUser?.role!=='admin'){toast('Solo disponible para administradores.','er');return}cheatFeatures[f]=!cheatFeatures[f];const btn=document.getElementById('ct-'+f);const labels={walls:'🧱 Atravesar Paredes',immune:'🛡️ Inmunidad',speed:'⚡ Super Velocidad'};btn.textContent=labels[f]+': '+(cheatFeatures[f]?'ON':'OFF');btn.classList.toggle('on',cheatFeatures[f]);const iframe=document.getElementById('game-iframe');if(iframe.contentWindow){try{iframe.contentWindow.postMessage({nexplay_cheat:{feature:f,enabled:cheatFeatures[f]}},'*')}catch(e){}}if(cheatFeatures[f]){injectCheatScript(f)}toast((cheatFeatures[f]?'✅ ':'❌ ')+labels[f].replace(/[^a-zA-Z ]/g,'').trim()+' '+(cheatFeatures[f]?'activado':'desactivado'),cheatFeatures[f]?'ok':'info')}
function injectCheatScript(feature){const iframe=document.getElementById('game-iframe');if(!iframe||!iframe.contentDocument)return;try{const s=iframe.contentDocument.createElement('script');const scripts={walls:`window._nxWalls=true;(function(){const orig=HTMLElement.prototype.getBoundingClientRect;HTMLElement.prototype.getBoundingClientRect=function(){const r=orig.call(this);if(r.width>0&&r.height>0)return{...r,width:r.width+100,height:r.height+100};return r}})()`,immune:`window._nxImmune=true;(function(){const ops=['damage','hurt','kill','die'];ops.forEach(op=>{window[op]=()=>{}})})()`,speed:`window._nxSpeed=true;(function(){const orig=setInterval;window.setInterval=(fn,d,...a)=>orig(fn,Math.max(1,d/2),...a)})()` };s.textContent=scripts[feature]||'';iframe.contentDocument.head?.appendChild(s)}catch(e){}}
// FULLSCREEN
function openFS(){if(!currentGame)return;document.getElementById('fs-iframe').src=document.getElementById('game-iframe').src;document.getElementById('fsoverlay').classList.remove('hidden');document.body.style.overflow='hidden'}
function closeFS(){document.getElementById('fsoverlay').classList.add('hidden');document.getElementById('fs-iframe').src='about:blank';document.body.style.overflow=''}
// SEARCH
let st=null;function doSearch(v){clearTimeout(st);const d=document.getElementById('sdrop');if(!v.trim()){d.classList.add('hidden');return}st=setTimeout(()=>{const games=(DB.get('games')||[]).filter(g=>g.status==='approved'&&(g.title.toLowerCase().includes(v.toLowerCase())||g.category.toLowerCase().includes(v.toLowerCase())||(g.tags||[]).some(t=>t.toLowerCase().includes(v.toLowerCase())))).slice(0,6);if(!games.length){d.classList.add('hidden');return}d.innerHTML=games.map(g=>`<div class="si" onclick="openGame('${g.id}');document.getElementById('sdrop').classList.add('hidden')"><img src="${gcImg(g)}" alt="${g.title}" style="pointer-events:none"/><div><div style="font-weight:800;font-size:13px">${g.title}</div><div style="font-size:11px;color:var(--tx2)">${g.category}</div></div></div>`).join('');d.classList.remove('hidden')},300)}
// PROFILE
function renderProfile(){if(!currentUser)return;const u=currentUser;document.getElementById('pav').textContent=u.avatar||u.username[0];document.getElementById('p-uname').innerHTML=u.username+(u.verified?'<span class="vbadge"></span>':'');document.getElementById('p-joined').textContent='Miembro desde '+new Date(u.joined).toLocaleDateString('es');document.getElementById('p-bio').textContent=u.bio||'';const rb=document.getElementById('p-rbadge');rb.textContent=u.role==='admin'?'🛡️ Administrador':u.role==='dev'?'🎮 Desarrollador':'🕹️ Jugador';rb.className='rbadge '+u.role;document.getElementById('s-played').textContent=(u.history||[]).length;document.getElementById('s-likes').textContent=u.likesGiven||0;document.getElementById('s-favs').textContent=(u.favorites||[]).length;document.getElementById('s-sess').textContent=u.sessions||0;const hg=(DB.get('games')||[]).filter(g=>(u.history||[]).includes(g.id)).slice(0,6);renderGG('p-recent',hg)}
function showEditProfile(){document.getElementById('edit-un').value=currentUser.username;document.getElementById('edit-bio').value=currentUser.bio||'';document.getElementById('edit-av').value=currentUser.avatar||'';showModal('edit-profile-modal')}
function saveProfile(){const un=document.getElementById('edit-un').value.trim();const bio=document.getElementById('edit-bio').value.trim();const av=document.getElementById('edit-av').value.trim();if(badWord(un)){toast('🚫 Nombre inapropiado.','er');return}const users=DB.get('users')||[];const ui=users.findIndex(u=>u.id===currentUser.id);if(ui===-1)return;users[ui].username=un||currentUser.username;users[ui].bio=bio;users[ui].avatar=av||currentUser.avatar;DB.set('users',users);currentUser=users[ui];setupNav();renderProfile();closeModal('edit-profile-modal');toast('✅ Perfil actualizado','ok')}
function changePW(){const old=document.getElementById('cpw-old').value,nw=document.getElementById('cpw-new').value,cf=document.getElementById('cpw-conf').value,err=document.getElementById('cpw-err');const users=DB.get('users')||[];const ui=users.findIndex(u=>u.id===currentUser.id);if(users[ui].password!==old){showErr(err,'❌ Contraseña actual incorrecta.');return}if(nw.length<6){showErr(err,'⚠️ Mínimo 6 caracteres.');return}if(nw!==cf){showErr(err,'❌ No coinciden.');return}users[ui].password=nw;DB.set('users',users);currentUser=users[ui];closeModal('change-pw-modal');toast('✅ Contraseña cambiada','ok')}
function renderFavs(){if(!currentUser)return;renderGG('fav-gg',(DB.get('games')||[]).filter(g=>(currentUser.favorites||[]).includes(g.id)))}
function renderHist(){if(!currentUser)return;renderGG('hist-gg',(DB.get('games')||[]).filter(g=>(currentUser.history||[]).includes(g.id)))}
function renderAch(){const ACH=[{i:'🎮',n:'Primer Juego',d:'Juega 1 juego',req:1,k:'history'},{i:'🎯',n:'Gamer',d:'Juega 10 juegos',req:10,k:'history'},{i:'🏆',n:'Pro Gamer',d:'Juega 25 juegos',req:25,k:'history'},{i:'❤️',n:'Fan',d:'Da 5 me gusta',req:5,k:'likesGiven'},{i:'🔥',n:'Fanático',d:'Da 20 me gusta',req:20,k:'likesGiven'},{i:'⭐',n:'Coleccionista',d:'5 favoritos',req:5,k:'favorites'},{i:'💎',n:'Elite',d:'15 favoritos',req:15,k:'favorites'},{i:'🌟',n:'Veterano',d:'10 sesiones',req:10,k:'sessions'}];const u=currentUser;document.getElementById('achg').innerHTML=ACH.map(a=>{const val=Array.isArray(u[a.k])?(u[a.k]||[]).length:(u[a.k]||0);const pct=Math.min(100,Math.floor((val/a.req)*100));const done=val>=a.req;return`<div class="achc ${done?'unlock':'lock'}"><span class="ai">${done?a.i:'🔒'}</span><h4>${a.n}</h4><p>${a.d}</p><div class="ach-prog"><div class="ach-prog-fill" style="width:${pct}%"></div></div><p style="font-size:11px;color:var(--tx2);margin-top:6px">${val}/${a.req}</p></div>`}).join('')}
function confirmDeleteAccount(){if(confirm('¿Eliminar tu cuenta? Esta acción es irreversible.')){const users=(DB.get('users')||[]).filter(u=>u.id!==currentUser.id);DB.set('users',users);DB.del('session');currentUser=null;hideAll();document.getElementById('splash').classList.remove('hidden');toast('Cuenta eliminada.','info')}}
// TEAM PUBLIC PROFILE
function viewTeamProfile(teamId){const teams=DB.get('teams')||[];const t=teams.find(x=>x.id===teamId);if(!t){toast('Equipo no encontrado.','er');return}const teamGames=(DB.get('games')||[]).filter(g=>g.devId===t.ownerId&&g.status==='approved');document.getElementById('team-profile-content').innerHTML=`
<div class="team-profile-hero">
  <div class="img-protected">${t.logo?`<img src="${t.logo}" class="team-logo-big" alt="${t.name}" />`:`<div class="team-logo-big" style="display:flex;align-items:center;justify-content:center;font-size:52px">🏢</div>`}</div>
  <div class="team-info-big">
    <h2>${t.name}${t.banned?'<span style="color:var(--er)"> 🚫</span>':''} <span class="vbadge" title="Equipo verificado"></span></h2>
    <p>${t.desc||'Sin descripción'}</p>
    <div class="team-members">
      ${(t.members||[]).map(m=>`<span class="team-member-chip">👤 ${m}</span>`).join('')}
    </div>
    <div style="font-size:12px;color:var(--tx2);margin-top:10px">📅 Creado: ${new Date(t.created).toLocaleDateString('es')}</div>
    <div class="team-social-links">
      ${t.twitter?`<a class="social-btn" href="https://twitter.com/${t.twitter}" target="_blank">🐦 ${t.twitter}</a>`:''}
      ${t.youtube?`<a class="social-btn" href="${t.youtube}" target="_blank">📺 YouTube</a>`:''}
      ${t.web?`<a class="social-btn" href="${t.web}" target="_blank">🌐 Sitio web</a>`:''}
    </div>
  </div>
</div>
<div class="sh"><h2>🎮 Juegos del equipo (${teamGames.length})</h2></div>
<div class="gg">${teamGames.length?teamGames.map(g=>gameCard(g)).join(''):'<p style="color:var(--tx2);padding:20px;grid-column:1/-1">Sin juegos publicados todavía.</p>'}</div>`;
showSection('team-profile')}
// DEV PANEL
function renderDev(){if(!currentUser)return;renderTeamBox();const games=(DB.get('games')||[]).filter(g=>g.devId===currentUser.id);const pending=(DB.get('pending')||[]).filter(g=>g.devId===currentUser.id);renderGG('dev-gg',[...pending,...games])}
function renderTeamBox(){const teams=DB.get('teams')||[];const t=teams.find(x=>x.ownerId===currentUser.id);const box=document.getElementById('dteam');if(t){box.innerHTML=`<div class="tdisp"><div class="tlogo img-protected">${t.logo?`<img src="${t.logo}" style="width:66px;height:66px;border-radius:18px;object-fit:cover;pointer-events:none" alt=""/>`:'🏢'}</div><div class="tinfo"><h3>${t.name}</h3><p>${t.desc||'Sin descripción'}</p><div class="tlock">🔒 Equipo protegido</div></div><div style="display:flex;gap:10px;margin-left:auto"><button class="btn-s" onclick="loadTeamForm();showModal('team-modal')">✏️ Editar</button><button class="btn-s" onclick="viewTeamProfile('${t.id}')">👁️ Ver perfil público</button></div></div>`}else{box.innerHTML=`<div style="text-align:center;padding:28px"><div style="font-size:52px;margin-bottom:14px">🏢</div><h3 style="margin-bottom:8px">Crea tu estudio</h3><p style="color:var(--tx2);margin-bottom:20px;font-size:14px">Configura tu identidad como desarrollador</p><button class="btn-p" onclick="showModal('team-modal')">+ Crear equipo</button></div>`}}
function loadTeamForm(){const t=(DB.get('teams')||[]).find(x=>x.ownerId===currentUser.id);if(!t)return;document.getElementById('tm-name').value=t.name;document.getElementById('tm-desc').value=t.desc||'';document.getElementById('tm-members').value=(t.members||[]).join(', ');document.getElementById('tm-twitter').value=t.twitter||'';document.getElementById('tm-youtube').value=t.youtube||'';document.getElementById('tm-web').value=t.web||'';if(t.logo){const prev=document.getElementById('tm-logo-preview');prev.src=t.logo;prev.classList.add('show');document.getElementById('tm-logo-data').value=t.logo}}
function saveTeam(){const name=document.getElementById('tm-name').value.trim();if(!name){toast('El nombre es obligatorio.','er');return}const teams=DB.get('teams')||[];const idx=teams.findIndex(t=>t.ownerId===currentUser.id);const logoData=document.getElementById('tm-logo-data').value;const membersRaw=document.getElementById('tm-members').value;const td={id:idx!==-1?teams[idx].id:'t_'+Date.now(),name,desc:document.getElementById('tm-desc').value.trim(),logo:logoData||teams[idx]?.logo||'',members:membersRaw.split(',').map(m=>m.trim()).filter(Boolean),twitter:document.getElementById('tm-twitter').value.trim(),youtube:document.getElementById('tm-youtube').value.trim(),web:document.getElementById('tm-web').value.trim(),pw:document.getElementById('tm-pw').value,ownerId:currentUser.id,ownerName:currentUser.username,banned:false,created:idx!==-1?teams[idx].created:new Date().toISOString()};if(idx!==-1)teams[idx]=td;else teams.push(td);DB.set('teams',teams);const games=DB.get('games')||[];games.forEach((g,i)=>{if(g.devId===currentUser.id)games[i].dev=name});DB.set('games',games);closeModal('team-modal');renderTeamBox();toast('✅ Equipo guardado','ok');addLog('Equipo creado/editado: '+name,currentUser.username,'🏢')}
function submitGame(){const name=document.getElementById('pub-name').value.trim(),desc=document.getElementById('pub-desc').value.trim(),url=document.getElementById('pub-url').value.trim();if(!name||!desc||!url){toast('Completa los campos obligatorios.','er');return}const teams=DB.get('teams')||[];const team=teams.find(t=>t.ownerId===currentUser.id);const coverData=document.getElementById('pub-cover-data').value;const pending=DB.get('pending')||[];const ng={id:'g_'+Date.now(),title:name,desc,url,cover:coverData||'',category:document.getElementById('pub-cat').value,tags:document.getElementById('pub-tags').value.split(',').map(t=>t.trim()).filter(Boolean),dev:team?team.name:currentUser.username,devId:currentUser.id,likes:0,dislikes:0,fire:0,wow:0,love:0,haha:0,sad:0,plays:0,featured:false,status:'pending',reactions:{},submittedAt:new Date().toISOString()};pending.push(ng);DB.set('pending',pending);closeModal('pub-modal');['pub-name','pub-desc','pub-url','pub-tags'].forEach(id=>document.getElementById(id).value='');document.getElementById('pub-cover-data').value='';document.getElementById('pub-cover-preview').classList.remove('show');toast('✅ Enviado para revisión','ok');addLog('Juego enviado: '+name,currentUser.username,'🎮');addNotif('🎮','Nuevo juego pendiente','El dev '+currentUser.username+' envió "'+name+'".',false,'admin001')}
// ADMIN
function renderAdmin(){renderAdminStats();document.querySelectorAll('.atab').forEach((t,i)=>{t.classList.toggle('on',i===0)});document.querySelectorAll('.acont').forEach((c,i)=>{c.classList.toggle('on',i===0)});renderAUsers()}
function renderAdminStats(){const users=DB.get('users')||[];const games=DB.get('games')||[];const pending=DB.get('pending')||[];const teams=DB.get('teams')||[];const reports=DB.get('reports')||[];document.getElementById('astats').innerHTML=`<div class="astat"><div class="astat-n">${users.length}</div><div class="astat-l">👥 Usuarios</div></div><div class="astat"><div class="astat-n">${games.filter(g=>g.status==='approved').length}</div><div class="astat-l">🎮 Juegos</div></div><div class="astat"><div class="astat-n">${pending.length}</div><div class="astat-l">⏳ Pendientes</div></div><div class="astat"><div class="astat-n">${reports.filter(r=>r.status==='pending').length}</div><div class="astat-l">🚩 Reportes</div></div>`}
function adminTab(btn,id){document.querySelectorAll('.atab').forEach(t=>t.classList.remove('on'));document.querySelectorAll('.acont').forEach(c=>c.classList.remove('on'));btn.classList.add('on');document.getElementById(id).classList.add('on');if(id==='ausers')renderAUsers();else if(id==='agames')renderAGames();else if(id==='ateams')renderATeams();else if(id==='apending')renderAPending();else if(id==='areports')renderAReports();else if(id==='alogs')renderALogs();else if(id==='anotifs')renderANotifs();else if(id==='acontent')renderAContent();else if(id==='asettings')renderASettings()}
function renderAUsers(){const users=DB.get('users')||[];document.getElementById('ausers').innerHTML=`<div style="display:flex;gap:10px;margin-bottom:16px"><input id="usrq" placeholder="🔍 Buscar..." style="background:var(--bg2);border:1px solid var(--bd);border-radius:10px;padding:9px 14px;color:var(--tx);font-family:'Nunito',sans-serif;font-size:14px;flex:1" oninput="filterAUsers(this.value)"/></div><div id="ausers-list">${buildUT(users)}</div>`}
function filterAUsers(q){const users=(DB.get('users')||[]).filter(u=>u.username.toLowerCase().includes(q.toLowerCase())||u.email.toLowerCase().includes(q.toLowerCase()));document.getElementById('ausers-list').innerHTML=buildUT(users)}
function buildUT(users){return`<table class="atable"><thead><tr><th>Usuario</th><th>Email</th><th>Rol</th><th>Estado</th><th>Sesiones</th><th>Acciones</th></tr></thead><tbody>${users.map(u=>`<tr><td><div class="urow"><div class="uav">${u.avatar||u.username[0]}</div><span style="font-weight:800">${u.username}${u.verified?'<span class="vbadge"></span>':''}</span></div></td><td style="color:var(--tx2);font-size:12px">${u.email}</td><td><span class="rbadge ${u.role}">${u.role==='admin'?'🛡️':u.role==='dev'?'🎮':'🕹️'} ${u.role}</span></td><td><span class="sdot ${u.banned?'off':'on'}"></span>${u.banned?'Baneado':'Activo'}</td><td style="color:var(--tx2)">${u.sessions||0}</td><td><div class="abtns">${u.id!==currentUser.id?`${u.banned?`<button class="ab unban" onclick="banUser('${u.id}',false)">✅</button>`:`<button class="ab ban" onclick="banUser('${u.id}',true)">🚫</button>`}${u.role==='player'?`<button class="ab promo" onclick="promoteU('${u.id}','dev')">⬆️Dev</button>`:''}${u.role==='dev'?`<button class="ab warn" onclick="promoteU('${u.id}','player')">⬇️Jugador</button>`:''}${u.role!=='admin'?`<button class="ab promo" onclick="promoteU('${u.id}','admin')">👑Admin</button>`:''}${u.role==='admin'?`<button class="ab warn" onclick="promoteU('${u.id}','player')">⬇️Bajar</button>`:''}${!u.verified?`<button class="ab feat" onclick="verifyU('${u.id}',true)">✓ Verificar</button>`:`<button class="ab warn" onclick="verifyU('${u.id}',false)">✓ Quitar</button>`}<button class="ab info" onclick="msgUser('${u.id}')">📩</button><button class="ab rej" onclick="showReportUser('${u.id}','${u.username}')">🚩</button>`:`<span style="color:var(--tx2);font-size:11px">(tú)</span>`}</div></td></tr>`).join('')}</tbody></table>`}
function banUser(id,ban){const users=DB.get('users')||[];const i=users.findIndex(u=>u.id===id);if(i!==-1){users[i].banned=ban;DB.set('users',users)}renderAUsers();toast(ban?'🚫 Baneado':'✅ Desbaneado',ban?'er':'ok');addLog((ban?'Baneó':'Desbaneó')+': '+users.find(u=>u.id===id)?.username,currentUser.username,'👥')}
function promoteU(id,role){const users=DB.get('users')||[];const i=users.findIndex(u=>u.id===id);if(i!==-1){users[i].role=role;DB.set('users',users)}renderAUsers();toast('✅ Rol → '+role,'ok');addLog('Cambió rol de '+users.find(u=>u.id===id)?.username+' a '+role,currentUser.username,'👥')}
function verifyU(id,v){const users=DB.get('users')||[];const i=users.findIndex(u=>u.id===id);if(i!==-1){users[i].verified=v;DB.set('users',users)}renderAUsers();toast(v?'✓ Verificado':'Verificación removida',v?'ok':'info')}
function msgUser(id){const msg=prompt('Escribe un mensaje para este usuario:');if(!msg)return;const u=(DB.get('users')||[]).find(x=>x.id===id);addNotif('📩','Mensaje del Admin',msg,false,id);toast('📩 Mensaje enviado a '+u?.username,'ok')}
function renderAGames(){const games=DB.get('games')||[];document.getElementById('agames').innerHTML=`<div style="display:flex;gap:10px;margin-bottom:16px"><input placeholder="🔍 Buscar juego..." style="background:var(--bg2);border:1px solid var(--bd);border-radius:10px;padding:9px 14px;color:var(--tx);font-family:'Nunito',sans-serif;font-size:14px;flex:1" oninput="filterAGames(this.value)" id="gq"/></div><div id="agames-list">${buildGT(games)}</div>`}
function filterAGames(q){document.getElementById('agames-list').innerHTML=buildGT((DB.get('games')||[]).filter(g=>g.title.toLowerCase().includes(q.toLowerCase())||g.dev.toLowerCase().includes(q.toLowerCase())))}
function buildGT(games){return`<table class="atable"><thead><tr><th>Juego</th><th>Dev</th><th>Cat.</th><th>👍</th><th>Plays</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>${games.map(g=>`<tr><td><div style="display:flex;align-items:center;gap:10px">${g.cover?`<img src="${g.cover}" width="36" height="36" style="border-radius:7px;object-fit:cover;pointer-events:none" />`:'<span style="font-size:24px">🎮</span>'}<span style="font-weight:800">${g.title}</span></div></td><td style="color:var(--tx2)">${g.dev}</td><td><span style="font-size:12px">${g.category}</span></td><td>${g.likes||0}</td><td>${fmtN(g.plays||0)}</td><td><span class="sdot ${g.status==='approved'?'on':g.status==='pending'?'pend':'off'}"></span>${g.status}</td><td><div class="abtns">${g.featured?`<button class="ab warn" onclick="featGame('${g.id}',false)">⭐ Quitar</button>`:`<button class="ab feat" onclick="featGame('${g.id}',true)">⭐ Dest.</button>`}${g.status==='banned'?`<button class="ab ok" onclick="banGame('${g.id}',false)">✅</button>`:`<button class="ab ban" onclick="banGame('${g.id}',true)">🚫</button>`}</div></td></tr>`).join('')}</tbody></table>`}
function featGame(id,v){const games=DB.get('games')||[];const i=games.findIndex(g=>g.id===id);if(i!==-1){games[i].featured=v;DB.set('games',games)}renderAGames();renderHome();toast(v?'⭐ Destacado':'Quitado','ok')}
function banGame(id,ban){const games=DB.get('games')||[];const i=games.findIndex(g=>g.id===id);if(i!==-1){games[i].status=ban?'banned':'approved';DB.set('games',games)}renderAGames();renderHome();toast(ban?'🚫 Baneado':'✅ Restaurado',ban?'er':'ok')}
function renderATeams(){const teams=DB.get('teams')||[];const el=document.getElementById('ateams');if(!teams.length){el.innerHTML='<p style="color:var(--tx2);padding:24px;text-align:center">No hay equipos.</p>';return}el.innerHTML=teams.map(t=>`<div class="tcard"><div class="tcard-l"><div class="tcard-logo">${t.logo?`<img src="${t.logo}" style="width:52px;height:52px;object-fit:cover;border-radius:12px;pointer-events:none" />`:'🏢'}</div><div><div style="font-weight:800;font-size:15px">${t.name}</div><div style="font-size:12px;color:var(--tx2)">${t.ownerName} · ${new Date(t.created).toLocaleDateString('es')}</div><div style="font-size:12px;color:var(--tx2);margin-top:3px">${(t.members||[]).join(', ')}</div></div></div><div class="abtns"><button class="ab feat" onclick="featTeam('${t.id}')">⭐</button>${t.banned?`<button class="ab unban" onclick="banTeam('${t.id}',false)">✅</button>`:`<button class="ab ban" onclick="banTeam('${t.id}',true)">🚫</button>`}<button class="ab promo" onclick="viewTeamProfile('${t.id}')">👁️</button></div></div>`).join('')}
function banTeam(id,ban){const teams=DB.get('teams')||[];const i=teams.findIndex(t=>t.id===id);if(i!==-1){teams[i].banned=ban;DB.set('teams',teams)}renderATeams();toast(ban?'🚫 Equipo baneado':'✅ Restaurado',ban?'er':'ok')}
function featTeam(){toast('⭐ Equipo destacado','ok')}
function renderAPending(){const pending=DB.get('pending')||[];const el=document.getElementById('apending');if(!pending.length){el.innerHTML='<p style="color:var(--tx2);padding:28px;text-align:center">✅ Sin pendientes.</p>';return}el.innerHTML=pending.map(g=>`<div class="pcard">${g.cover?`<img src="${g.cover}" alt="${g.title}" />`:'<span style="font-size:40px;flex-shrink:0">🎮</span>'}<div class="pc-inf"><h4>${g.title}</h4><p>Por <strong>${g.dev}</strong> · ${g.category}</p><p style="margin-top:4px">${g.desc.slice(0,100)}...</p>${(g.tags||[]).length?`<div style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap">${(g.tags||[]).map(t=>`<span style="background:var(--bg2);border:1px solid var(--bd);border-radius:5px;padding:2px 7px;font-size:11px">${t}</span>`).join('')}</div>`:''}<a href="${g.url}" target="_blank" style="color:var(--t);font-size:12px;margin-top:6px;display:inline-block">🔗 Ver juego</a></div><div class="abtns" style="flex-direction:column"><button class="ab ok" onclick="approveGame('${g.id}')">✅ Aprobar</button><button class="ab rej" onclick="rejectGame('${g.id}')">❌ Rechazar</button></div></div>`).join('')}
function approveGame(id){const pending=DB.get('pending')||[];const i=pending.findIndex(g=>g.id===id);if(i===-1)return;const g={...pending[i],status:'approved',approvedAt:new Date().toISOString()};pending.splice(i,1);DB.set('pending',pending);const games=DB.get('games')||[];games.unshift(g);DB.set('games',games);renderAPending();renderHome();renderAdminStats();toast('✅ Aprobado y publicado','ok');addLog('Aprobó juego: '+g.title,currentUser.username,'✅');addNotif('🎉','¡Tu juego fue aprobado!','"'+g.title+'" ya está en NexPlay.',false,g.devId)}
function rejectGame(id){const g=(DB.get('pending')||[]).find(x=>x.id===id);DB.set('pending',(DB.get('pending')||[]).filter(x=>x.id!==id));renderAPending();renderAdminStats();toast('❌ Rechazado','er');if(g){addLog('Rechazó juego: '+g.title,currentUser.username,'❌');addNotif('😔','Tu juego fue rechazado','"'+g.title+'" no cumple los criterios.',false,g.devId)}}
function renderAReports(){const reports=DB.get('reports')||[];const el=document.getElementById('areports');if(!reports.length){el.innerHTML='<p style="color:var(--tx2);padding:24px;text-align:center">Sin reportes pendientes.</p>';return}el.innerHTML=`<table class="atable"><thead><tr><th>Tipo</th><th>Objetivo</th><th>Motivo</th><th>Por</th><th>Fecha</th><th>Acciones</th></tr></thead><tbody>${reports.map(r=>`<tr><td><span style="font-size:18px">${r.type==='game'?'🎮':'👤'}</span></td><td style="font-weight:700">${r.targetName}</td><td>${r.reason}</td><td style="color:var(--tx2)">${r.by}</td><td style="color:var(--tx2);font-size:12px">${new Date(r.time).toLocaleDateString('es')}</td><td><div class="abtns"><button class="ab ok" onclick="resolveReport('${r.id}')">✅ Resolver</button><button class="ab ban" onclick="actOnReport('${r.id}')">🚫 Actuar</button></div></td></tr>`).join('')}</tbody></table>`}
function resolveReport(id){DB.set('reports',(DB.get('reports')||[]).filter(r=>r.id!==id));renderAReports();renderAdminStats();toast('✅ Reporte resuelto','ok')}
function actOnReport(id){const r=(DB.get('reports')||[]).find(x=>x.id===id);if(!r)return;if(r.type==='game')banGame(r.target,true);else if(r.type==='user')banUser(r.target,true);resolveReport(id);toast('🚫 Acción tomada','ok')}
function renderALogs(){const logs=(DB.get('logs')||[]).slice().reverse().slice(0,50);const el=document.getElementById('alogs');el.innerHTML=logs.length?`<table class="atable"><thead><tr><th>Ícono</th><th>Acción</th><th>Por</th><th>Fecha</th></tr></thead><tbody>${logs.map(l=>`<tr><td>${l.icon}</td><td>${l.action}</td><td style="color:var(--tx2)">${l.by}</td><td style="color:var(--tx2);font-size:12px">${new Date(l.time).toLocaleString('es')}</td></tr>`).join('')}</tbody></table>`:'<p style="color:var(--tx2);padding:24px;text-align:center">Sin actividad.</p>'}
function renderANotifs(){document.getElementById('anotifs').innerHTML=`<div style="display:flex;gap:12px;margin-bottom:20px;flex-wrap:wrap"><button class="btn-p" onclick="showModal('send-notif-modal')">📣 Enviar Notificación Global</button></div><h4 style="margin-bottom:14px;font-size:15px">Historial de notificaciones</h4><div id="anotif-list"></div>`;document.getElementById('anotif-list').innerHTML=(DB.get('notifs')||[]).slice(0,20).map(n=>`<div style="background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:16px;margin-bottom:10px;display:flex;gap:14px"><span style="font-size:24px">${n.icon}</span><div><div style="font-weight:800;font-size:14px">${n.title}</div><div style="font-size:13px;color:var(--tx2)">${n.body}</div><div style="font-size:11px;color:var(--tx2);margin-top:4px">${new Date(n.time).toLocaleString('es')}</div></div></div>`).join('')||'<p style="color:var(--tx2)">Sin notificaciones.</p>'}
function sendGlobalNotif(){const title=document.getElementById('sn-title').value.trim(),body=document.getElementById('sn-body').value.trim(),icon=document.getElementById('sn-icon').value.trim()||'🔔';if(!title||!body){toast('Completa título y mensaje.','er');return}addNotif(icon,title,body,true);closeModal('send-notif-modal');document.getElementById('sn-title').value='';document.getElementById('sn-body').value='';toast('📣 Notificación enviada','ok');pushNotif(icon,title,body);addLog('Notificación global: '+title,currentUser.username,'📣');renderANotifs()}
function renderAContent(){const blocks=DB.get('content_blocks')||[];document.getElementById('acontent').innerHTML=`
  <div style="display:flex;gap:12px;margin-bottom:20px;flex-wrap:wrap">
    <button class="btn-p" onclick="openContentEditor(null)">+ Nuevo bloque</button>
    <p style="color:var(--tx2);font-size:14px;align-self:center">Edita el contenido de la página de inicio desde aquí.</p>
  </div>
  <div id="blocks-list">
    ${blocks.length?blocks.map((b,i)=>`<div class="content-block"><div class="content-block-header"><h4>${b.title||'Bloque sin título'}</h4><div style="display:flex;gap:8px"><button class="cb-edit-btn" onclick="openContentEditor(${i})">✏️ Editar</button><button class="ab ban" onclick="deleteBlock(${i})" style="padding:6px 11px">🗑️</button></div></div>${b.img?`<img src="${b.img}" style="width:100%;max-height:120px;object-fit:cover;border-radius:10px;margin-bottom:10px;pointer-events:none" alt=""/>`:''}${b.body?`<p style="color:var(--tx2);font-size:13px">${b.body}</p>`:''}</div>`).join(''):'<p style="color:var(--tx2);padding:20px">Sin bloques de contenido todavía.</p>'}
  </div>`}
function openContentEditor(idx){document.getElementById('ce-block-id').value=idx!==null?idx:'';document.getElementById('ce-title').textContent=idx!==null?'✏️ Editar Bloque':'+ Nuevo Bloque';if(idx!==null){const b=(DB.get('content_blocks')||[])[idx]||{};document.getElementById('ce-block-title').value=b.title||'';document.getElementById('ce-block-body').value=b.body||'';document.getElementById('ce-color').value=b.color||'#1a1a32';if(b.img){const prev=document.getElementById('ce-img-preview');prev.src=b.img;prev.classList.add('show');document.getElementById('ce-img-data').value=b.img}}else{document.getElementById('ce-block-title').value='';document.getElementById('ce-block-body').value='';document.getElementById('ce-color').value='#1a1a32';document.getElementById('ce-img-data').value='';document.getElementById('ce-img-preview').classList.remove('show')}showModal('content-editor-modal')}
function saveContentBlock(){const title=document.getElementById('ce-block-title').value.trim();const body=document.getElementById('ce-block-body').value.trim();const img=document.getElementById('ce-img-data').value;const color=document.getElementById('ce-color').value;const idxRaw=document.getElementById('ce-block-id').value;const blocks=DB.get('content_blocks')||[];const block={title,body,img,color,updatedAt:new Date().toISOString()};if(idxRaw!==''){const i=parseInt(idxRaw);blocks[i]=block}else blocks.push(block);DB.set('content_blocks',blocks);closeModal('content-editor-modal');renderAContent();renderCustomBlocks();toast('✅ Bloque guardado','ok')}
function deleteBlock(idx){if(!confirm('¿Eliminar este bloque?'))return;const blocks=DB.get('content_blocks')||[];blocks.splice(idx,1);DB.set('content_blocks',blocks);renderAContent();renderCustomBlocks();toast('🗑️ Bloque eliminado','info')}
function renderASettings(){const admin=(DB.get('users')||[]).find(u=>u.id===currentUser.id)||{};document.getElementById('asettings').innerHTML=`<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px"><div style="background:var(--card);border:1px solid var(--bd);border-radius:20px;padding:26px"><h3 style="font-size:16px;font-weight:800;margin-bottom:16px">🔧 Credenciales</h3><div style="margin-bottom:14px"><div style="font-size:11px;color:var(--tx2);margin-bottom:4px">USUARIO</div><div style="font-weight:800;font-size:16px;display:flex;align-items:center;gap:6px">${admin.username||''}<span class="vbadge"></span></div></div><div style="display:flex;gap:10px;flex-wrap:wrap"><button class="btn-p" onclick="showModal('admin-creds-modal')">✏️ Cambiar</button><button class="btn-s" onclick="openShareAdmin()">📤 Compartir</button></div></div><div style="background:var(--card);border:1px solid var(--bd);border-radius:20px;padding:26px"><h3 style="font-size:16px;font-weight:800;margin-bottom:16px">📊 Stats Globales</h3><div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">${buildPlatStats()}</div></div><div style="background:var(--card);border:1px solid var(--bd);border-radius:20px;padding:26px"><h3 style="font-size:16px;font-weight:800;margin-bottom:16px">🌐 Plataforma</h3><div class="srow"><span style="font-size:13px">Registro abierto</span><label class="tog"><input type="checkbox" checked><span></span></label></div><div class="srow"><span style="font-size:13px">Modo mantenimiento</span><label class="tog"><input type="checkbox"><span></span></label></div><div class="srow"><span style="font-size:13px">Juegos de devs visibles</span><label class="tog"><input type="checkbox" checked><span></span></label></div></div><div style="background:var(--card);border:1px solid var(--bd);border-radius:20px;padding:26px"><h3 style="font-size:16px;font-weight:800;margin-bottom:16px">🧹 Herramientas</h3><div style="display:flex;flex-direction:column;gap:10px"><button class="ab warn" onclick="clearLogs()" style="padding:10px 16px;font-size:13px">🗑️ Limpiar logs</button><button class="ab info" onclick="exportData()" style="padding:10px 16px;font-size:13px">📥 Exportar datos</button><button class="ab rej" onclick="if(confirm('¿Resetear todo?'))resetPlatform()" style="padding:10px 16px;font-size:13px">⚠️ Resetear plataforma</button></div></div></div>`}
function buildPlatStats(){const users=DB.get('users')||[];const games=DB.get('games')||[];const totalPlays=games.reduce((a,g)=>a+(g.plays||0),0);const totalLikes=games.reduce((a,g)=>a+(g.likes||0),0);return[['👥',users.length,'Usuarios'],['🎮',games.length,'Juegos'],['🎯',fmtN(totalPlays),'Plays'],['👍',fmtN(totalLikes),'Likes']].map(([i,n,l])=>`<div style="text-align:center;background:var(--bg2);border-radius:12px;padding:14px"><div style="font-size:24px">${i}</div><div style="font-size:20px;font-weight:800;color:var(--t)">${n}</div><div style="font-size:11px;color:var(--tx2)">${l}</div></div>`).join('')}
function changeAdminCreds(){const un=document.getElementById('ac-user').value.trim(),pw=document.getElementById('ac-pw').value,pw2=document.getElementById('ac-pw2').value,err=document.getElementById('ac-err');if(!un||!pw){showErr(err,'Completa los campos.');return}if(pw!==pw2){showErr(err,'Las contraseñas no coinciden.');return}if(pw.length<6){showErr(err,'Mínimo 6 caracteres.');return}const users=DB.get('users')||[];const i=users.findIndex(u=>u.id===currentUser.id);if(i!==-1){users[i].username=un;users[i].password=pw;DB.set('users',users);currentUser=users[i]}setupNav();closeModal('admin-creds-modal');toast('✅ Credenciales actualizadas','ok');addLog('Cambió credenciales admin',un,'🔧')}
function openShareAdmin(){document.getElementById('share-content').innerHTML=`<div class="share-card"><div class="sc-img">${currentUser.avatar||'🛡️'}</div><div class="sc-name">@${currentUser.username}<span class="vbadge" style="width:22px;height:22px;margin-left:8px"></span></div><div class="sc-role">Administrador Oficial NexPlay ✓</div></div>`;window._shareText='@'+currentUser.username+' — Administrador Verificado de NexPlay ✓ | nexplay.gg';showModal('share-modal')}
function clearLogs(){DB.set('logs',[]);if(document.getElementById('alogs').classList.contains('on'))renderALogs();toast('🗑️ Logs limpiados','ok')}
function exportData(){const d={users:DB.get('users'),games:DB.get('games'),teams:DB.get('teams'),logs:DB.get('logs')};const b=new Blob([JSON.stringify(d,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='nexplay-data.json';a.click();toast('📥 Datos exportados','ok')}
function resetPlatform(){['users','games','teams','pending','notifs','logs','session','reports','content_blocks'].forEach(k=>DB.del(k));location.reload()}
// NOTIFICATIONS
function addNotif(icon,title,body,global=false,userId=null){const notifs=DB.get('notifs')||[];notifs.unshift({id:'n_'+Date.now(),icon,title,body,time:new Date().toISOString(),read:false,global,userId});DB.set('notifs',notifs.slice(0,100));updateNBadge()}
function addLog(action,by,icon='📋'){const logs=DB.get('logs')||[];logs.unshift({action,by,icon,time:new Date().toISOString()});DB.set('logs',logs.slice(0,200))}
function toggleNotifPanel(){const p=document.getElementById('notif-panel');p.classList.toggle('hidden');if(!p.classList.contains('hidden'))renderNotifPanel()}
function renderNotifPanel(){const notifs=(DB.get('notifs')||[]).filter(n=>n.global||n.userId===currentUser?.id).slice(0,20);document.getElementById('np-list').innerHTML=notifs.length?notifs.map(n=>`<div class="nitem ${n.read?'':'unread'}" onclick="markRead('${n.id}')"><div style="display:flex;gap:12px;align-items:flex-start"><span style="font-size:22px">${n.icon}</span><div><div class="nitem-title">${n.title}</div><div class="nitem-body">${n.body}</div><div class="nitem-time">${timeAgo(n.time)}</div></div></div></div>`).join(''):'<p style="color:var(--tx2);padding:24px;text-align:center">Sin notificaciones.</p>'}
function markRead(id){const notifs=DB.get('notifs')||[];const i=notifs.findIndex(n=>n.id===id);if(i!==-1)notifs[i].read=true;DB.set('notifs',notifs);renderNotifPanel();updateNBadge()}
function markAllRead(){DB.set('notifs',(DB.get('notifs')||[]).map(n=>({...n,read:true})));renderNotifPanel();updateNBadge()}
function updateNBadge(){if(!currentUser)return;const u=(DB.get('notifs')||[]).filter(n=>(n.global||n.userId===currentUser.id)&&!n.read).length;const b=document.getElementById('nbdg');if(b){b.textContent=u;b.classList.toggle('hidden',u===0)}}
function pushNotif(icon,title,body){if(!document.getElementById('tog-notif')?.checked)return;const el=document.createElement('div');el.className='push-notif';el.innerHTML=`<span class="push-notif-icon">${icon}</span><div class="push-notif-body"><h5>${title}</h5><p>${body}</p></div><button class="push-close" onclick="this.parentElement.remove()">✕</button>`;document.body.appendChild(el);setTimeout(()=>{el.classList.add('out');setTimeout(()=>el.remove(),300)},4500)}
// MODALS
function showModal(id){document.getElementById(id).classList.remove('hidden')}
function closeModal(id){document.getElementById(id).classList.add('hidden')}
document.addEventListener('click',e=>{if(e.target.classList.contains('modal'))e.target.classList.add('hidden')});
// UTILS
function showErr(el,msg){el.textContent=msg;el.classList.remove('hidden')}
function toast(msg,type='info'){const t=document.getElementById('toast');t.textContent=msg;t.className=type;t.classList.remove('hidden');clearTimeout(window._tt);window._tt=setTimeout(()=>t.classList.add('hidden'),3200)}
function delay(ms){return new Promise(r=>setTimeout(r,ms))}
function fmtN(n){if(n>=1e6)return(n/1e6).toFixed(1)+'M';if(n>=1e3)return(n/1e3).toFixed(1)+'K';return''+n}
function randEmoji(){return['🎮','🕹️','🎯','🎲','⚡','🔥','💎','🚀','🌟','🐉'][Math.floor(Math.random()*10)]}
function timeAgo(iso){const s=Math.floor((Date.now()-new Date(iso))/1000);if(s<60)return'Ahora';if(s<3600)return Math.floor(s/60)+'m';if(s<86400)return Math.floor(s/3600)+'h';return Math.floor(s/86400)+'d'}
// STARTUP
document.addEventListener('DOMContentLoaded',()=>{initDB();blockAds();const sid=DB.get('session');if(sid){const u=(DB.get('users')||[]).find(x=>x.id===sid);if(u&&!u.banned){currentUser=u;hideAll();enterApp();return}}document.getElementById('splash').classList.remove('hidden')});
